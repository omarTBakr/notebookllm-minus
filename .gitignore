# Live secrets are not tracked. The `.env*` files hold real API keys, so only the
# templates (`.env.example`, `Docker/env.example/`) are committed; copy one to
# `src/.env` / `Docker/env/` and fill it in. A file that was tracked before this
# rule still has to be removed from the index with `git rm --cached`.
.env
.env.*
!.env.example
!Docker/env.example/.env.*

# AWS SSH keys are secrets too.
private_ssh_aws/

# Everything listed here is machine-specific or regenerated, and none of it is
# portable: a virtualenv hardcodes absolute paths, caches rebuild themselves.

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments — rebuilt with `uv sync`, ~500 MB, absolute paths inside
.venv

# Caches
.pytest_cache/
.ruff_cache/

# Logs
logs/
*.log
*.log.[0-9]*

# Embedded vector store (VECTOR_DB_PATH) — regenerated by re-indexing
qdrant_db/
skills/

# The tessdata_best Arabic model build_dataset.py needs (12.6 MB, third-party,
# fetched with one curl command — see fineTuning/README.md). Same reasoning
# as the OCR results above: a fetchable binary, not something to track.
fineTuning/tessdata_best/

# The fine-tuning dataset itself: hundreds of small per-page JSON files,
# fully regenerated from the tracked source PDFs in fineTuning/assets/ by
# fineTuning/genrateData/build_dataset.py. Same category as src/ocr/results/
# above — derived data, not a deliverable in its own right.
fineTuning/data/
