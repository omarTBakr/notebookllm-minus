# Copy to evals/.env (gitignored) and fill in. Read by ragas_eval.py and locustfile.py.

# The running stack. nginx publishes the app on 8081; `uv run uvicorn` serves 8000.
EVAL_BASE_URL=http://localhost:8081

# A test account on that stack. It is signed up on first use if it does not exist.
# Use one made for testing, never a real account's password.
EVAL_EMAIL=eval@example.test
EVAL_PASSWORD=REPLACE_ME

# --- Ragas judge ---------------------------------------------------------------
# ollama: a local model. openai: any OpenAI-compatible API (OpenAI, NVIDIA NIM,
# OpenRouter) at RAGAS_JUDGE_BASE_URL, with its key in RAGAS_JUDGE_API_KEY.
RAGAS_JUDGE_BACKEND=ollama
RAGAS_JUDGE_MODEL=llama3.1:8b
RAGAS_EMBED_MODEL=nomic-embed-text
RAGAS_JUDGE_BASE_URL=http://localhost:11434
# RAGAS_JUDGE_API_KEY=

# --- Locust --------------------------------------------------------------------
# A notebook that already has sources, shared by every simulated user. Leave
# empty and each user makes its own and uploads the sample document.
LOAD_CHAT_ID=

# --- Demo recording (demo/record/walkthrough.py) ---------------------------------
# The account the walkthrough signs in as. Signed up through the real form on
# the first run. A test account, like the one above.
DEMO_EMAIL=demo@example.test
DEMO_PASSWORD=REPLACE_ME
