# Template for Docker/env/.env.postgres. Read by the pgvector and
# postgres-exporter containers (env_file: in docker-compose.yml); compose loads
# it by itself, no --env-file flag.
#
# The image's own variable names, and the same three names .env.app uses. The
# values must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB there.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="REPLACE_ME"
POSTGRES_DB="notebookllm-minus"
