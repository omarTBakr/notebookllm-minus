# Template for Docker/env/.env.postgres. Read by `docker compose` itself
# (--env-file), substituted into docker-compose.yml (the pgvector container and
# the postgres-exporter DSN); not passed to a container as a file.
#
# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB in .env.app. The
# name here is POSTGRES_PASS, which is what docker-compose.yml substitutes;
# spelling it POSTGRES_PASSWORD leaves it unset and compose refuses to start.
POSTGRES_USERNAME="postgres"
POSTGRES_PASS="REPLACE_ME"
POSTGRES_MAIN_DB="notebookllm-minus"
