# Self-hosted Langfuse (tracing + prompt versioning), compose profile `langfuse`.
# Read by langfuse-web, langfuse-worker and its own postgres, clickhouse, minio
# and redis, so each secret is written once per pair below and must match
# within this file. Generate secrets with:  openssl rand -hex 32
#
# The app connects with the project keys under "headless init". Put the same
# two keys in env/.env.app as LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY and set
# LANGFUSE_ENABLED=true there.

# --- web UI --------------------------------------------------------------------
# The address you open in a browser (host port 3001; Grafana already has 3000).
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=REPLACE_ME__openssl_rand_hex_32
SALT=REPLACE_ME__openssl_rand_hex_32
# Exactly 64 hex characters.
ENCRYPTION_KEY=REPLACE_ME__openssl_rand_hex_32
TELEMETRY_ENABLED=false
LANGFUSE_DISABLE_SIGNUP_ONBOARDING=true

# --- headless init: org, project, keys and first user on first boot -----------
LANGFUSE_INIT_ORG_ID=notebookllm
LANGFUSE_INIT_ORG_NAME=NotebookLLM-minus
LANGFUSE_INIT_PROJECT_ID=notebookllm-minus
LANGFUSE_INIT_PROJECT_NAME=notebookllm-minus
# Must start with pk-lf- / sk-lf-. Copy both into env/.env.app.
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-REPLACE_ME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-REPLACE_ME
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=REPLACE_ME__min_8_chars

# --- postgres (langfuse-postgres) ---------------------------------------------
# Its own server, not pgvector: the app database gets reset and restored on its
# own schedule, and Langfuse's data should not go with it.
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=REPLACE_ME__openssl_rand_hex_16
POSTGRES_DB=langfuse
# Same user and password as the three lines above.
DATABASE_URL=postgresql://langfuse:REPLACE_ME__openssl_rand_hex_16@langfuse-postgres:5432/langfuse

# --- clickhouse (traces and observations) --------------------------------------
CLICKHOUSE_DB=default
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=REPLACE_ME__openssl_rand_hex_16
CLICKHOUSE_MIGRATION_URL=clickhouse://langfuse-clickhouse:9000
CLICKHOUSE_URL=http://langfuse-clickhouse:8123
CLICKHOUSE_CLUSTER_ENABLED=false

# --- redis (langfuse-redis: queues, so noeviction, never the app's LRU redis) --
REDIS_HOST=langfuse-redis
REDIS_PORT=6379
REDIS_AUTH=REPLACE_ME__openssl_rand_hex_16

# --- minio (S3: raw events and media) ----------------------------------------
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=REPLACE_ME__openssl_rand_hex_16
# The access keys below are MINIO_ROOT_USER / MINIO_ROOT_PASSWORD again.
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=REPLACE_ME__openssl_rand_hex_16
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://langfuse-minio:9000
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_REGION=auto
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=REPLACE_ME__openssl_rand_hex_16
# Media URLs are opened by the browser, so this is the host-mapped port.
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://localhost:9002
LANGFUSE_S3_MEDIA_UPLOAD_INTERNAL_ENDPOINT=http://langfuse-minio:9000
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=media/
