# RabbitMQ configuration — only honoured on the container's first boot
# (empty /var/lib/rabbitmq). See Docker/services/rabbitmq/rabbitmq.conf for broker
# settings and Docker/README.md for what each key does.
RABBITMQ_DEFAULT_USER=appuser
# Generate:  openssl rand -base64 24   (must equal CELERY_PASSWORD in .env.app)
RABBITMQ_DEFAULT_PASS=REPLACE_ME__openssl_rand_base64_24
RABBITMQ_DEFAULT_VHOST=/
# Generate:  openssl rand -hex 32
RABBITMQ_ERLANG_COOKIE=REPLACE_ME__openssl_rand_hex_32
