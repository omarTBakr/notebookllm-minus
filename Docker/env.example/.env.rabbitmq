# RabbitMQ configuration — only honoured on the container's first boot
# (empty /var/lib/rabbitmq). See Docker/rabbitmq/rabbitmq.conf for broker
# settings and Docker/README.md for what each key does.
RABBITMQ_DEFAULT_USER=appuser
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_DEFAULT_VHOST=/
# openssl rand -hex 32
RABBITMQ_ERLANG_COOKIE=change-me-to-a-random-secret
