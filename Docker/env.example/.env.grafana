# Grafana configuration
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
# Note: You can add other GF_ variables here as needed by Grafana.

# Served inside the app at /grafana/ (nginx proxies it there, behind the app's
# sign-in), as well as on its own port. %(domain)s is the host the request
# came in on, so one value works on localhost and on a server.
GF_SERVER_ROOT_URL=%(protocol)s://%(domain)s/grafana/
GF_SERVER_SERVE_FROM_SUB_PATH=true
# Lets the app's Visualization view frame it. Without this Grafana sends
# X-Frame-Options: deny and the tab stays blank.
GF_SECURITY_ALLOW_EMBEDDING=true
# Read-only access without a second sign-in. The framed copy is only reachable
# through nginx after the app has checked the session.
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer
