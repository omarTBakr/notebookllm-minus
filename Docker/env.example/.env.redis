# Redis configuration. Redis itself reads settings from redis.conf, not this
# file — REDIS_PASSWORD here must match `requirepass` in Docker/services/redis/redis.conf
# exactly, or the app gets NOAUTH/WRONGPASS. See Docker/README.md.
# Generate:  openssl rand -base64 24 | tr -d '/+='   (no spaces)
REDIS_PASSWORD=REPLACE_ME__openssl_rand_base64_24
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
