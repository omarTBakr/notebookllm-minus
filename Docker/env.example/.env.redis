# Redis configuration. Redis itself reads settings from redis.conf, not this
# file — REDIS_PASSWORD here must match `requirepass` in Docker/redis/redis.conf
# exactly, or the app gets NOAUTH/WRONGPASS. See Docker/README.md.
REDIS_PASSWORD=change-me
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://:change-me@redis:6379/0
