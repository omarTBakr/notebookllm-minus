# Template for Docker/env/.env.mongo. Read by the mongo container (env_file:
# in docker-compose.yml); compose loads it by itself, no --env-file flag.
#
# Only used with `docker compose --profile mongo`. Must match MONGO_USER /
# MONGO_PASSWORD in .env.app.
MONGO_INITDB_ROOT_USERNAME="root"
MONGO_INITDB_ROOT_PASSWORD="REPLACE_ME"
