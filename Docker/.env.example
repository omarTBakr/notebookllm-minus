# Copy to .env. These five are read by docker compose itself and substituted
# into docker-compose.yml as ${...} — they are NOT passed to the application,
# which takes its configuration from env/.env.app.
#
# .env is gitignored; this template is not.

# Only used with `docker compose --profile mongo`.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change-me

# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB in env/.env.app —
# the same server seen from the other side.
POSTGRES_USERNAME=postgres
POSTGRES_PASS=change-me
POSTGRES_MAIN_DB=notebookllm-minus
