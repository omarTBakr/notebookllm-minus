# Read by docker-compose.yml. Copy to Docker/.env and fill in.

# --- mongo ---
MONGO_INITDB_ROOT_USERNAME = "username"
MONGO_INITDB_ROOT_PASSWORD = "password"

# --- postgres + pgvector ---
# These three name the superuser and database the container creates on first
# boot. They must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB in
# src/.env — that is the same server seen from the application side.
#
# Note the port: compose publishes 5432 in the container as **5400** on the
# host, so src/.env wants POSTGRES_PORT = 5400.
#
# These are only read when the volume is first created. Changing them later
# does nothing until `docker compose down -v` throws the volume away.
POSTGRES_USERNAME = "postgres"
POSTGRES_PASS = "password"
POSTGRES_MAIN_DB = "notebookllm-minus"
