# Copy to src/.env and edit. Values here are the defaults unless noted.
#
# Every "one of ..." list below is backed by an enum in src/enums/, so a wrong
# value fails at startup with the full list of what is allowed, rather than at
# first use. Case and surrounding whitespace do not matter.

# --- application -------------------------------------------------------------
APPLICATION_NAME = 'NotebookLLM-minus'
APP_VERSION = "v3"

# --- uploads -----------------------------------------------------------------
ALLOWED_TYPES = ["application/pdf", "text/plain", "text/markdown"]
MAX_FILE_SIZE = 10485760          # 10 MB — rejected at upload, and the Asset
                                   # model's file_bytes ceiling (models/db_schema/asset.py)
MAX_FILE_CHUNK_SIZE = 65536       # streaming read chunk size in bytes. 64 KB,
                                  # not 1 KB: a 50 MB upload is 800 reads
                                  # rather than 51,200 round trips.

# --- document database -------------------------------------------------------
# Which store backs users, sessions, chats, messages, projects, assets, chunks.
#
#   mongo     documents in MongoDB, vectors in Qdrant  (two services)
#   postgres  documents *and* vectors in PostgreSQL    (one service, pgvector)
#
# Not interchangeable at runtime: each keeps its own data. See the README's
# "Database backends".
DOCUMENT_DB_BACKEND = "mongo"

# --- mongodb -----------------------------------------------------------------
# Only read when DOCUMENT_DB_BACKEND = "mongo". Settings builds the DSN from
# these rather than a single MONGO_URI, so there is no URI string to keep in
# sync with the fields below it.
#
# Docker Compose (Docker/docker-compose.yml) starts Mongo with root/example.
MONGO_HOST = "localhost"
MONGO_PORT = 27017
MONGO_USER = "root"
MONGO_PASSWORD = "example"
MONGO_DB_NAME = "notebookllm_minus"

# --- postgresql (+ pgvector) -------------------------------------------------
# Only read when DOCUMENT_DB_BACKEND = "postgres". The DSN is assembled from
# these five, so there is no DATABASE_URL to keep in sync.
#
# The port is 5400, not 5432: compose publishes the pgvector container that
# way. USER / PASSWORD / DB must match POSTGRES_USERNAME / POSTGRES_PASS /
# POSTGRES_MAIN_DB in Docker/.env — same server seen from the other side.
#
# The schema is owned by Alembic and applied at startup; nothing to run by hand.
POSTGRES_HOST     = "localhost"
POSTGRES_PORT     = 5400
POSTGRES_USER     = "postgres"
POSTGRES_PASSWORD = "password"
POSTGRES_DB       = "notebookllm-minus"

# --- vector database ---------------------------------------------------------
# Only read when DOCUMENT_DB_BACKEND = "mongo" — the Postgres backend keeps its
# vectors in the database configured above and ignores these entirely.
#
# !! Embedded/on-disk mode (VECTOR_DB_PATH) is currently commented out of
# !! Settings (utils/config.py), so a running Qdrant is required: set
# !! VECTOR_DB_HOST/PORT to point at one.
VECTOR_DB_HOST = "localhost"
VECTOR_DB_PORT = 6333
# VECTOR_DB_API_KEY = ""              # only for a remote/cloud cluster
#
# One of: cosine | dot | euclid. Fixed when a collection is created, so
# changing it later means rebuilding the collection.
VECTOR_DB_DISTANCE_METHOD = "cosine"
#
# One of: hnsw | ivfflat. The ANN index VectorRepository.create_index() builds
# by default — call it (or pass index_type explicitly) once a collection has
# its data, not before. ivfflat is pgvector-only; Qdrant only builds hnsw and
# raises if this is set to ivfflat there.
VECTOR_DB_INDEX_TYPE = "hnsw"

# --- llm providers -----------------------------------------------------------
# Which vendor answers questions, and which one turns chunks into vectors.
# The two sets differ on purpose: Anthropic ships no embeddings API, so it is
# a valid GENERATION_BACKEND but not a valid EMBEDDING_BACKEND. The two need
# not agree — running ollama for embeddings and a hosted model for answers is
# a perfectly good setup.
GENERATION_BACKEND = "ollama"   # anthropic | openai | google | cohere | nvidia | ollama
EMBEDDING_BACKEND  = "ollama"   #             openai | google | cohere | nvidia | ollama

# Only the key for the backend(s) you selected has to be filled in; the app
# fails at startup, not on first request, if the selected one is blank.
# Ollama is the exception: it runs on your own machine and takes no key.
ANTHROPIC_API_KEY = ""
# Identity-linked Anthropic keys are scoped to a workspace, and Anthropic
# rejects the request outright without one: "anthropic-workspace-id is required
# when authenticating with an identity-linked API key". Leave empty for an
# ordinary key — the header is then omitted entirely rather than sent blank,
# which is itself an error. Console -> Settings -> Workspaces; it looks like
# "wrkspc_01ABC...".
ANTHROPIC_WORKSPACE_ID = ""
ANTHROPIC_MODEL_ID = "claude-sonnet-4-20250514"
OPENAI_API_KEY    = ""
GOOGLE_API_KEY    = ""
GOOGLE_MODEL_ID   = "gemini-3.6-flash"   # 2.5-* is refused for new keys: 404 "no longer available to new users"
COHERE_API_KEY    = ""
# OPENAI_API_BASE_URL = ""            # only for OpenAI-compatible endpoints

# NVIDIA NIM (build.nvidia.com). Its API is OpenAI's, so it runs through the
# same provider class pointed at https://integrate.api.nvidia.com/v1 — kept
# separate from OPENAI_API_KEY / OPENAI_API_BASE_URL so both vendors can be
# configured at the same time. One key covers both chat and embeddings. Model
# ids carry the publisher: GENERATION_MODEL_ID = "meta/llama-3.2-11b-vision-instruct",
# EMBEDDING_MODEL_ID = "nvidia/nemotron-3-embed-1b".
#
# Beware: /v1/models lists the whole catalogue, not what your account may
# call. Most ids answer 404 "Function ...: Not found for account ..." — check
# a model with a single curl before putting it in here.
NVIDIA_API_KEY = ""
# Everything below defaults to what the hosted endpoint wants; set them only
# for a self-hosted NIM, or when NVIDIA moves its limits.
# NVIDIA_API_BASE_URL = "https://integrate.api.nvidia.com/v1"
# NVIDIA_EMBEDDING_MAX_BATCH = 256    # inputs per embeddings request; over
                                      # this, the provider splits the batch
# NVIDIA_EMBEDDING_TRUNCATE = "end"   # none | start | end — what to do with a
                                      # text longer than the model's context.
                                      # none fails the request instead.

# Where `ollama serve` is listening. Only consulted when a backend above is
# set to "ollama"; the model must already be pulled (`ollama pull <model>`).
OLLAMA_HOST = "localhost"
OLLAMA_PORT = 11434

# A second ollama somewhere else on the network — a GPU box, a tunnel. Its
# models appear in the picker alongside the local ones, badged "web" rather
# than "local", and a chat can name either. Leave it unset for local-only;
# if it is set but unreachable, its models are simply missing from the list.
# OLLAMA_CLOUD_BASE_URL = "https://your-host.example"

# --- generation --------------------------------------------------------------
GENERATION_MODEL_ID = "gemma3:4b"
GENERATION_DEFAULT_MAX_TOKENS = 4096
GENERATION_DEFAULT_TEMPERATURE = 0.1  # low: answers should stick to the sources
#
# Ask the model to expose its reasoning. One of: true | false | low | medium |
# high (1/yes/on and 0/no/off are accepted as true/false). Ollama-only, and
# dropped automatically for models that do not support it.
GENERATION_THINKING = "true"

# --- embedding ---------------------------------------------------------------
EMBEDDING_MODEL_ID   = "nomic-embed-text"
EMBEDDING_MODEL_SIZE = 768
# EMBEDDING_MODEL_SIZE must match the model. It is baked into the vector
# collection at creation time, so a mismatch means every insert is rejected,
# and changing it later requires rebuilding the collection.
#
#   openai   text-embedding-3-small    1536   (shortenable via `dimensions`)
#   openai   text-embedding-3-large    3072   (shortenable via `dimensions`)
#   cohere   embed-v4.0                1536   (also 256 / 512 / 1024)
#   google   gemini-embedding-001      3072   (also 1536 / 768)
#   ollama   nomic-embed-text           768   (fixed)
#   ollama   mxbai-embed-large         1024   (fixed)
#   ollama   qwen3-embedding:8b        4096   (fixed, multilingual)
#   nvidia   nemotron-3-embed-1b       2048   (fixed; the endpoint rejects any
#                                              other `dimensions` outright)
#
# NVIDIA caps a request at NVIDIA_EMBEDDING_MAX_BATCH inputs (256 by default),
# under CHUNKING_BATCH_SIZE's 512 — the provider splits the batch itself, so
# neither setting needs adjusting.
#
# Ollama sizes are fixed — the size cannot be requested, so EMBEDDING_MODEL_SIZE
# must match the model exactly. It is checked on the first embed call, which
# fails with the actual width if the two disagree.

# --- chat --------------------------------------------------------------------
DEFAULT_LANG       = "en"   # en | ar — prompt locale when a chat names none
CHAT_HISTORY_LIMIT = 10     # prior turns sent to the model as context
RETRIEVAL_TOP_K    = 5      # chunks retrieved per grounded answer
# Passages scoring below this never reach the prompt. 0.0 keeps everything;
# raise it only after looking at real scores for your own corpus.
RETRIEVAL_MIN_SCORE = 0.0

# --- extraction --------------------------------------------------------------
# Which library reads text out of a PDF. Measured on a 274-page Arabic
# document, whole file, counting real words recovered:
#
#   pypdf        29s    8-9/14 words    90,874 lost glyphs
#   pdfplumber   52s      0/14 words    92,514 lost glyphs
#   pymupdf     520s     11/14 words         0 lost glyphs   <- default
#
# pdfplumber orders characters by x-position, so right-to-left text comes out
# REVERSED — it looks like Arabic and matches nothing. Do not use it on an RTL
# corpus. It is the better choice for Latin documents with tables.
#
# pymupdf is the default: it loses no glyphs at all, and it is the only one
# that captures the word coordinates a citation's highlight is drawn from
# (PdfLayoutController) — pypdf and pdfplumber cannot produce a highlight
# regardless of anything else, a document just opens at the right page with
# none. The 520s above is serial; PdfLayoutController splits extraction
# across a process pool since pages don't depend on one another, which
# brought that down to ~79s at 24 workers on the machine this was measured
# on — sized to whichever is smaller of a cgroup CPU quota (Docker's
# --cpus) and the process's core affinity, not the host's raw count, so a
# CPU-limited container sees correspondingly less of the speedup.
#
# Set to pypdf to trade the highlight away for the original, much faster
# extraction (~0.1s/page) — retrieval quality is unaffected either way for a
# corpus that isn't presentation-form-heavy Arabic; see normalize_text.
PDF_LOADER = "pymupdf"        # pypdf | pdfplumber | pymupdf

# --- task queue (Celery) -----------------------------------------------------
# Long-running work — ingestion and embedding — runs in Celery workers rather
# than in the request. RabbitMQ carries the jobs; Redis stores their results.
#
# Host-shaped here, container-shaped in Docker/env/.env.app: from inside the
# compose network the two answer to "rabbitmq" and "redis", not localhost.
#
# These must match the broker's own credentials — Docker/env/.env.rabbitmq
# (RABBITMQ_DEFAULT_USER / _PASS) and Docker/env/.env.redis (REDIS_PASSWORD).
# A mismatch is not a startup error: the API keeps accepting work and the
# queue simply never drains.
CELERY_USERNAME = "guest"
CELERY_PASSWORD = "password"
CELERY_HOST     = "localhost"       # "rabbitmq" inside Docker
CELERY_PORT     = 5672
CELERY_VHOST    = "/"               # RabbitMQ virtual host

# Result backend. CELERY_BACKEND_PASSWORD may be left unset for a Redis with
# no requirepass — the auth segment is then omitted from the URL entirely
# rather than sending an empty AUTH the server would reject.
CELERY_BACKEND_HOST     = "localhost"   # "redis" inside Docker
CELERY_BACKEND_PORT     = 6379
CELERY_BACKEND_PASSWORD = "password"
CELERY_BACKEND_DB       = 0             # logical Redis DB index (0-15)

# classic | quorum. Quorum queues are RabbitMQ's modern default, and choosing
# them is also what stops Celery using the deprecated `global_qos` feature —
# the worker sets the global QoS flag on RabbitMQ unless it detects a quorum
# queue. Changing this on a live broker requires deleting the existing queues:
# a queue's type is fixed when it is declared.
CELERY_TASK_QUEUE_TYPE = "quorum"

# Soft limit fires inside the task so its cleanup runs; the hard limit above
# is a SIGKILL that skips every finally block. Soft must be below hard.
CELERY_TASK_SOFT_TIME_LIMIT = 540
# Report STARTED once a worker picks the task up, instead of PENDING.
CELERY_TASK_TRACK_STARTED = true
# How long a finished result stays readable, in seconds (7 days).
CELERY_RESULT_EXPIRES = 604800
# Task events. Required for Flower to show any task history at all.
CELERY_WORKER_SEND_TASK_EVENTS = true
# Emitted by the publisher, so a task no worker ever collected is still visible.
CELERY_TASK_SEND_SENT_EVENT = true

# How often the task-table sweep runs, in hours.
CELERY_MAINTENANCE_INTERVAL_HOURS = 24
# How long a finished task's row is kept, in days. Past CELERY_RESULT_EXPIRES
# there is nothing left to cross-check it against.
CELERY_TASK_RETENTION_DAYS = 7


# --- Flower (Celery dashboard) -------------------------------------------
# Flower reads these directly from the environment; the application does not
# pass them on. Published on http://localhost:5555.
#
# FLOWER_PORT must match the "5555:5555" mapping and the healthcheck in
# docker-compose.yml -- a Compose ports: mapping cannot read env_file.
FLOWER_PORT = 5555
# Commented out on purpose, and it must stay that way to mean "no auth".
# FLOWER_BASIC_AUTH="" does NOT disable authentication -- Flower reads an empty
# string as "auth is on, with no valid users" and answers 401 to every route
# except /healthcheck, so the container looks healthy while the dashboard is
# unreachable. Uncomment with a real "user:password" to require a login.
# FLOWER_BASIC_AUTH = "admin:change-me"
# Survive restarts: a dashboard for failed and unfinished tasks is least
# useful immediately after the restart a failure tends to cause.
FLOWER_PERSISTENT = true
FLOWER_DB = "/app/flower/flower.db"
FLOWER_MAX_TASKS = 10000
# Forget workers replaced by a redeploy instead of showing them as capacity.
FLOWER_PURGE_OFFLINE_WORKERS = 300


# One queue per workload, so a slow embedding run cannot starve ingestion.
# Each has its own worker container in docker-compose.yml.
CELERY_PROJECT_NAME       = "notebookllm"
CELERY_TASK_DEFAULT_QUEUE = "notebookllm.default"
CELERY_QUEUE_PROCESS      = "notebookllm.process_data_task"
CELERY_QUEUE_INDEX        = "notebookllm.index_project_task"
CELERY_QUEUE_CHAT         = "notebookllm.answer_chat_task"
CELERY_QUEUE_MAINTENANCE  = "notebookllm.maintenance_task"

# Serialisation. json rather than pickle: a task payload arrives from another
# process, and pickle would make the broker a code-execution path.
CELERY_TASK_SERIALIZER   = "json"
CELERY_RESULT_SERIALIZER = "json"
CELERY_ACCEPT_CONTENT    = ["json"]
CELERY_TIMEZONE          = "UTC"
CELERY_ENABLE_UTC        = true

# Hard wall-clock limit per task. A 274-page PDF takes ~80s to extract, so
# this leaves room; lower it and long ingests are killed mid-run.
CELERY_TASK_TIME_LIMIT    = 600
CELERY_WORKER_CONCURRENCY = 2

# true: acknowledge only once the task finishes, so a worker killed mid-ingest
# returns the job to the queue instead of dropping it. Safe here because both
# tasks tolerate redelivery — process skips assets already chunked, and index
# upserts on a deterministic point id.
CELERY_TASK_ACKS_LATE = true

# Broker resilience. The workers start alongside RabbitMQ in compose, so the
# first connection frequently precedes the broker being ready.
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP = true
CELERY_BROKER_CONNECTION_RETRY            = true
CELERY_BROKER_CONNECTION_RETRY_DELAY      = 2      # seconds between attempts
CELERY_BROKER_CONNECTION_MAX_RETRIES      = 10     # 0 = retry forever

# Stop a late-acked task when the worker loses the broker, so it does not keep
# running invisibly and then finish against a job that was already requeued.
CELERY_WORKER_CANCEL_LONG_RUNNING_TASKS_ON_CONNECTION_LOSS = true

# Passed verbatim to the broker / backend drivers. Empty is right for AMQP;
# a Redis *broker* would want something like {"visibility_timeout": 3600}.
# CELERY_BROKER_TRANSPORT_OPTIONS = {}
# CELERY_RESULT_BACKEND_TRANSPORT_OPTIONS = {}

# --- logging -----------------------------------------------------------------
# All values below are optional; the defaults shown here apply when unset.
LOG_LEVEL = "INFO"          # CRITICAL | ERROR | WARNING | INFO | DEBUG | NOTSET
LOG_FORMAT = "text"         # text (human-readable) | json (structured)
LOG_TO_CONSOLE = true
LOG_TO_FILE = true
LOG_DIR = "logs"            # relative paths resolve against src/
LOG_FILE_NAME = "notebookllm-minus.log"
LOG_MAX_BYTES = 10485760    # 10 MB before rotating
LOG_BACKUP_COUNT = 5        # number of rotated files to keep
