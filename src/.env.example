APPLICATION_NAME = 'NotebookLLM-minus'
APP_VERSION = "0.1"

ALLOWED_TYPES = ["application/pdf", "text/plain"]
MAX_FILE_SIZE = 10485760          # 10 * 1024 * 1024 = 10 MB — rejected at upload
MAX_ASSET_SIZE_BYTES = 10485760   # hard ceiling on the bytes stored per asset
MAX_FILE_CHUNK_SIZE = 1024        # streaming read chunk size in bytes

# --- mongodb ---
# Docker Compose (Docker/docker-compose.yml) starts Mongo with root/example.
# With no database in the path, authSource defaults to admin (where the root
# user lives). Add ?authSource=admin explicitly if you append a database name.
MONGO_URI = "mongodb://root:example@localhost:27017"
MONGO_DB_NAME = "notebookllm_minus"

# --- llm providers ---
# Which vendor answers questions, and which one turns chunks into vectors.
# The two sets differ on purpose: Anthropic ships no embeddings API, so it is
# a valid GENERATION_BACKEND but not a valid EMBEDDING_BACKEND. The two need
# not agree — running ollama for embeddings and a hosted model for answers is
# a perfectly good setup.
GENERATION_BACKEND = "ollama"      # anthropic | openai | google | cohere | ollama
EMBEDDING_BACKEND  = "ollama"         # openai | google | cohere | ollama

# Only the key for the backend(s) you selected has to be filled in; the app
# fails at startup, not on first request, if the selected one is blank.
# Ollama is the exception: it runs on your own machine and takes no key.
ANTHROPIC_API_KEY = ""
OPENAI_API_KEY    = ""
GOOGLE_API_KEY    = ""
COHERE_API_KEY    = ""
# OPENAI_API_BASE_URL = ""            # only for OpenAI-compatible endpoints

# Where `ollama serve` is listening. Only consulted when a backend above is
# set to "ollama"; the model must already be pulled (`ollama pull <model>`).
OLLAMA_BASE_URL = "http://localhost:11434"

GENERATION_MODEL_ID = "gemma3:4b"
GENERATION_DEFAULT_MAX_TOKENS = 4096
GENERATION_THINKING = "true"   # true|false|low|medium|high — ollama reasoning models
GENERATION_DEFAULT_TEMPERATURE = 0.1  # low: answers should stick to the sources

EMBEDDING_MODEL_ID   = "nomic-embed-text"
EMBEDDING_MODEL_SIZE = 768
# EMBEDDING_MODEL_SIZE must match the model. It is baked into the vector
# collection at creation time, so a mismatch means every insert is rejected,
# and changing it later requires rebuilding the collection.
#
#   openai   text-embedding-3-small    1536   (shortenable via `dimensions`)
#   openai   text-embedding-3-large    3072   (shortenable via `dimensions`)
#   cohere   embed-v4.0                1536   (also 256 / 512 / 1024)
#   google   gemini-embedding-001      3072   (also 1536 / 768)
#   ollama   nomic-embed-text           768   (fixed)
#   ollama   mxbai-embed-large         1024   (fixed)
#
# Ollama sizes are fixed — the size cannot be requested, so EMBEDDING_MODEL_SIZE
# must match the model exactly. It is checked on the first embed call, which
# fails with the actual width if the two disagree.

# --- chat ---
DEFAULT_LANG       = "en"   # en | ar — prompt locale when a chat names none
CHAT_HISTORY_LIMIT = 10     # prior turns sent to the model as context
RETRIEVAL_TOP_K    = 5      # chunks retrieved per grounded answer

# --- vector database ---
# Embedded by default: VECTOR_DB_PATH is a local directory and nothing else
# needs to be running. Set VECTOR_DB_URL to point at a Qdrant server or Cloud
# cluster instead — the two are mutually exclusive and setting both is an error.
VECTOR_DB_BACKEND = "qdrant"
VECTOR_DB_PATH    = "qdrant_db"       # relative paths resolve against src/
# VECTOR_DB_URL     = "http://localhost:6333"
# VECTOR_DB_API_KEY = ""              # only for a remote/cloud cluster
VECTOR_DB_DISTANCE_METHOD = "cosine"  # cosine | dot | euclid — fixed at creation

# --- logging ---
# All values below are optional; the defaults shown here apply when unset.
LOG_LEVEL = "INFO"          # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT = "text"         # text (human-readable) | json (structured)
LOG_TO_CONSOLE = true
LOG_TO_FILE = true
LOG_DIR = "logs"            # relative paths resolve against src/
LOG_FILE_NAME = "notebookllm-minus.log"
LOG_MAX_BYTES = 10485760    # 10 MB before rotating
LOG_BACKUP_COUNT = 5        # number of rotated files to keep
